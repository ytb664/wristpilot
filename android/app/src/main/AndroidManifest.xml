<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeping the forwarder awake during a Navigation Session (NavigationSessionService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Navigation started" and the keep-awake notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The setup checklist's button to switch battery optimization off for Wristpilot. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The setup checklist opens Zepp and its settings. -->
    <queries>
        <package android:name="com.huami.watch.hmwatchmanager" />
    </queries>

    <application
        android:label="Wristpilot"
        android:icon="@android:drawable/ic_menu_directions"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MapsNotificationListener"
            android:exported="true"
            android:label="Wristpilot"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".NavigationSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Relays Google Maps navigation to a paired smartwatch for the length of a Navigation Session." />
        </service>

        <!-- Lets "Share" hand Drive Recordings to other apps. Authority must match DriveRecorder.shareIntent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.recordings"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recording_paths" />
        </provider>
    </application>
</manifest>
