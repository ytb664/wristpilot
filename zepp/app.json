{
  "configVersion": "v3",
  "app": {
    "appId": 1099001,
    "appName": "Wristpilot",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "wristpilot",
    "description": "Google Maps turn-by-turn guidance on the wrist"
