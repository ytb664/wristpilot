      },
      "platforms": [
        { "st": "r", "dw": 480, "deviceSource": 10813697 },
        { "st": "r", "dw": 480, "deviceSource": 10813699 }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Wristpilot"
